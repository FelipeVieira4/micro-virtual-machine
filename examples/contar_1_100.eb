; +================================+
; | REALIZAR CONTAGEM DE 1 ATÉ 100 |
; +================================+

SET R0, 0        ; 0: contador
SET R1, 25       ; 1: limite

loop_for:
SYS_CALL 0x00, R0

INC R0
LT R0, R1
JMP loop_for, 1

CALL print

SYS_EXIT         ; 15

; printar do 50... até 65
print:
SET R0, 50        ; 0: contador
SET R1, 65       ; 1: limite

loop_for_2:
SYS_CALL 0x00, R0

INC R0
LT R0, R1
JMP loop_for_2, 1

RETURN